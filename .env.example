# Copy this file to .env and adjust as needed.
# Shared by both services via docker-compose's `env_file: .env`.
# DATABASE_URL is set per-service directly in docker-compose.yml (same
# Postgres instance, separate schemas) and only needs overriding here for
# local (non-docker) development.

# Must be identical for auth and url-shortener: auth signs the JWT,
# url-shortener verifies it.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Public base url used by url-shortener to build the `shortUrl` it returns.
BASE_URL=http://localhost:3001
